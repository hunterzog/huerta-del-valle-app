<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Acceso a la API -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Permiso de cámara -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Cámara opcional -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HueraDelValle">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Registro -->
        <activity android:name=".RegistroActivity"/>

        <!-- Proyectos -->
        <activity android:name=".ProyectosActivity"/>

        <!-- Nuevo proyecto -->
        <activity android:name=".NuevoProyectoActivity"/>

        <!-- Configuración -->
        <activity android:name=".ConfiguracionCultivoActivity"/>

        <!-- Proyecto activo -->
        <activity android:name=".ProyectoActivoActivity"/>

        <!-- Monitoreo -->
        <activity android:name=".MonitoreoActivity"/>

        <!-- Administración -->
        <activity android:name=".AdministracionActivity"/>

        <!-- Gestión de usuarios -->
        <activity android:name=".GestionUsuariosActivity"/>

        <!-- Modificar usuario -->
        <activity android:name=".ModificarUsuarioActivity"/>

        <!-- Control de válvulas -->
        <activity android:name=".ControlValvulasActivity" android:exported="false" />

        <!-- Control de bombas -->
        <activity android:name=".ControlBombasActivity" android:exported="false" />

        <!-- Nivel de agua -->
        <activity android:name=".NivelAguaActivity" android:exported="false" />

        <!-- Evaluación diaria -->
        <activity android:name=".EvaluacionDiariaActivity"/>

        <!-- Historial de evaluaciones -->
        <activity android:name=".HistorialEvaluacionesActivity"/>

        <!-- Informe parcial -->
        <activity android:name=".InformeParcialActivity"/>

        <!-- Informe final -->
        <activity
            android:name=".InformeFinalActivity" android:exported="false" />

    </application>

</manifest>