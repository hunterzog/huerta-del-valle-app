<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permiso para conectarse a internet y a la API -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:usesCleartextTraffic="true"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HueraDelValle">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de registro de usuarios -->
        <activity android:name=".RegistroActivity"/>

        <!-- Pantalla de lista de proyectos -->
        <activity android:name=".ProyectosActivity"/>

        <!-- Pantalla de nuevo proyecto -->
        <activity android:name=".NuevoProyectoActivity"/>

        <!-- Pantalla de configuración del cultivo -->
        <activity android:name=".ConfiguracionCultivoActivity"/>

        <!-- Pantalla de proyecto activo -->
        <activity android:name=".ProyectoActivoActivity"/>

        <!-- Pantalla de monitoreo en tiempo real -->
        <activity android:name=".MonitoreoActivity"/>

        <!-- Pantalla de administración - solo administrador -->
        <activity android:name=".AdministracionActivity"/>

        <!-- Pantalla de gestión de usuarios - CRUD completo -->
        <activity android:name=".GestionUsuariosActivity"/>

        <!-- Pantalla de modificar usuario -->
        <activity android:name=".ModificarUsuarioActivity"/>

        <!-- Pantalla de control manual de las 5 electroválvulas -->
        <activity
            android:name=".ControlValvulasActivity"
            android:exported="false" />

    </application>

</manifest>