<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Historial de evaluaciones"
            android:textColor="#1B5E20"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProyectoHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="#2E7D32"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Resumen -->
        <TextView
            android:id="@+id/tvResumenHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="Cargando resumen..."
            android:textColor="#333333"
            android:textSize="16sp" />

        <!-- Promedios -->
        <TextView
            android:id="@+id/tvPromediosCriterios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:textColor="#333333"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Evaluaciones registradas"
            android:textColor="#1B5E20"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Lista diaria -->
        <LinearLayout
            android:id="@+id/contenedorEvaluaciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <Button
            android:id="@+id/btnVolverHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#FFFFFF"
            android:text="Volver"
            android:textColor="#2E7D32" />
    </LinearLayout>
</ScrollView>
