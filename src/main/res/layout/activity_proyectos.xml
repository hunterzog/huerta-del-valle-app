<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Barra superior con título y cerrar sesión -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E7D32"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mis Proyectos"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <!-- Cerrar sesión en la esquina superior derecha -->
        <TextView
            android:id="@+id/tvCerrarSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salir"
            android:textColor="#A5D6A7"
            android:textSize="14sp"
            android:textStyle="bold"
            android:padding="4dp"/>

    </LinearLayout>

    <!-- Buscador y ordenamiento -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etBuscarProyecto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:hint="🔍 Buscar proyecto..."
            android:inputType="text"
            android:background="@drawable/bg_input"
            android:padding="10dp"
            android:textSize="13sp"
            android:textColor="#212121"
            android:textColorHint="#757575"
            android:layout_marginEnd="8dp"/>

        <Spinner
            android:id="@+id/spinnerOrdenarProyectos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

    </LinearLayout>

    <!-- Total proyectos -->
    <TextView
        android:id="@+id/tvTotalProyectos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:paddingStart="12dp"
        android:text="Total: 0 proyectos"
        android:textSize="11sp"
        android:textColor="#757575"
        android:background="#F5F5F5"/>

    <!-- Lista de proyectos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvProyectos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"/>

    <!-- Botones de acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#FFFFFF">

        <!-- Crear nuevo proyecto -->
        <Button
            android:id="@+id/btnNuevoProyecto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="+ Nuevo Proyecto"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <!-- Continuar proyecto activo -->
        <Button
            android:id="@+id/btnContinuarProyecto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continuar Proyecto Activo"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <!-- Administración - solo para administrador -->
        <Button
            android:id="@+id/btnAdministracion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Administración"
            android:backgroundTint="#B71C1C"
            android:textColor="#FFFFFF"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>