<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2E7D32"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monitoreo en Tiempo Real"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- Tarjetas de sensores -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Temperatura -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌡️ Temperatura Ambiental"
                    android:textColor="#2E7D32"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvTemperatura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-- °C"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

            <!-- Humedad -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💧 Humedad Ambiental"
                    android:textColor="#1565C0"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvHumedad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-- %"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

            <!-- Temperatura del agua -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌊 Temperatura del Agua"
                    android:textColor="#00838F"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvTempAgua"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-- °C"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

            <!-- TDS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 TDS"
                    android:textColor="#6A1B9A"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvTds"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-- ppm"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

            <!-- pH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚗️ pH del Agua"
                    android:textColor="#C62828"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/tvPh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:layout_marginTop="8dp"/>

            </LinearLayout>

            <!-- Última actualización -->
            <TextView
                android:id="@+id/tvUltimaActualizacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Última actualización: --"
                android:textColor="#757575"
                android:textSize="12sp"
                android:gravity="center"/>

        </LinearLayout>

    </ScrollView>

    <!-- Botón volver -->
    <Button
        android:id="@+id/btnVolverMonitoreo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver"
        android:backgroundTint="#FFFFFF"
        android:textColor="#2E7D32"
        android:layout_margin="16dp"/>

</LinearLayout>