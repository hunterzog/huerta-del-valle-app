<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#C62828"
            android:gravity="center"
            android:padding="16dp"
            android:text="Informe final"
            android:textColor="#FFFFFF"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvProyectoInforme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#C62828"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFechaInforme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#757575"
            android:textSize="14sp" />

        <!-- Ayuda -->
        <TextView
            android:id="@+id/tvTooltipInforme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:padding="8dp"
            android:text="ⓘ Acerca del informe final"
            android:textColor="#C62828"
            android:textSize="14sp" />

        <!-- Datos del proyecto -->
        <TextView
            android:id="@+id/tvDatosProyectoInforme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:text="Cargando datos..."
            android:textColor="#212121"
            android:textSize="15sp" />

        <!-- Configuración -->
        <TextView
            android:id="@+id/tvConfiguracionInforme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:textColor="#212121"
            android:textSize="15sp" />

        <!-- Sensores -->
        <TextView
            android:id="@+id/tvSensoresInforme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:textColor="#212121"
            android:textSize="15sp" />

        <!-- Evaluaciones -->
        <TextView
            android:id="@+id/tvEvaluacionInforme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:textColor="#212121"
            android:textSize="15sp" />

        <!-- Observaciones -->
        <TextView
            android:id="@+id/tvObservacionesInforme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:textColor="#212121"
            android:textSize="15sp" />

        <!-- Foto reciente -->
        <ImageView
            android:id="@+id/ivFotoInforme"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="10dp"
            android:background="#EEEEEE"
            android:contentDescription="Fotografía reciente del cultivo"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Generar PDF -->
        <Button
            android:id="@+id/btnGenerarPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:backgroundTint="#C62828"
            android:text="Generar PDF"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnVolverInforme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#FFFFFF"
            android:text="Volver"
            android:textColor="#C62828" />
    </LinearLayout>
</ScrollView>
