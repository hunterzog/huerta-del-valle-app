<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#B71C1C"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nivel de Agua del Tanque"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Lectura actual del sensor"
                    android:textSize="14sp"
                    android:textColor="#555555"/>

                <TextView
                    android:id="@+id/tvNivelAgua"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-- cm"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tvUltimaActualizacion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:layout_marginTop="4dp"/>



            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Configuración de umbrales"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#222222"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Distancia cuando el tanque está lleno (cm)"
                    android:textSize="13sp"
                    android:textColor="#888888"/>

                <EditText
                    android:id="@+id/etDistanciaLleno"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:hint="Ej: 10"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Distancia cuando el tanque está vacío (cm)"
                    android:textSize="13sp"
                    android:textColor="#888888"/>

                <EditText
                    android:id="@+id/etDistanciaVacio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:hint="Ej: 20"
                    android:padding="10dp"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnGuardarUmbrales"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Guardar umbrales"
                    android:backgroundTint="#2E7D32"
                    android:textColor="#FFFFFF"
                    android:padding="14dp"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnVolverNivelAgua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver"
        android:backgroundTint="#FFFFFF"
        android:textColor="#B71C1C"
        android:padding="16dp"
        android:layout_margin="16dp"/>

</LinearLayout>